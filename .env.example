# Bodhi settings file — TEMPLATE.
#
# HOW TO USE (do this once):
#   1. Copy this file and name the copy exactly:  .env.local
#   2. Fill in the values after the = signs (no spaces, no quotes needed).
#   3. Restart the website (stop it and run: npm run dev).
#
# .env.local is NEVER uploaded to GitHub (it is git-ignored), so your
# secrets stay on your computer. On a hosting service (e.g. Render), do NOT
# upload this file — type the same names and values into the host's
# "Environment Variables" settings page instead.

# ---- Database (MongoDB) ----
# Leave EMPTY for local testing: an embedded MongoDB starts automatically and
# stores data in ./data/mongo (survives restarts, no installation needed).
# For the live site, paste your FREE MongoDB Atlas connection string here.
# It looks like: mongodb+srv://bodhi:YOURPASSWORD@cluster0.xxxxx.mongodb.net
# Step-by-step Atlas setup: see the Owner's Guide, section 5B.
MONGODB_URI=

# ---- AI generation (courses, study chapters, question-bank growth) ----
# Get it from: platform.openai.com -> API keys -> Create new secret key.
# It looks like: sk-proj-....  Shown only ONCE — copy it immediately.
OPENAI_API_KEY=

# Optional: which AI model to use. Leave empty for the default (gpt-4o-mini,
# the cheapest good one).
AI_MODEL=

# ---- Affiliate commissions on book links ----
# Amazon Associates tracking ID, e.g. bodhi-21
# Get it from: affiliate-program.amazon.in (needs your live website URL).
AMAZON_AFFILIATE_TAG=

# Flipkart affiliate ID — only if you have a DIRECT Flipkart affiliate
# account. Direct sign-up is usually paused; most people use Cuelinks or
# EarnKaro instead (those work differently — see the Owner's Guide).
FLIPKART_AFFILIATE_ID=
